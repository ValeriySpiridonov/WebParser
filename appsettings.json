{
  "crawler": {
    "maxConcurrency": 10,
    "maxAttempts": 3,
    "maxConcurrentPerHost": 2,
    "hostIdleSeconds": 600,
    "hostPruneThreshold": 5000,
    "hostPruneIntervalSeconds": 30,
    "maxPageSizeBytes": 5242880,
    "timeoutSeconds": 30,
    "retryBaseDelayMs": 500,
    "retryAfterCapSeconds": 30,
    "userAgent": "WebParser/1.0"
  },
  "logging": {
    "filePath": "log.txt",
    "maxFileSizeBytes": 8388608,
    "queueCapacity": 10000,
    "minLevel": "Info"
  }
}